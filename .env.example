SARVAM_API_KEY=
TAVILY_API_KEY=
FAILPROOF_MODE=report        # off | report | enforce
SARVAM_MODE=auto             # auto | native | json (json_schema fallback, spec section 4)
ROUTER=keyword               # keyword | laya
LAYA_CHECKPOINT_DIR=
STT_LANGUAGE=auto
STT_MODEL=saaras:v3-realtime
CODEX_MODEL=gpt-5.6-luna      # write_code coder; ChatGPT login allows gpt-5.6-luna/terra/sol, gpt-6-astra
TTS_MODEL=bulbul:v4-flash    # FINDINGS: v4-flash recommended; bulbul:v3 also works (speaker priya/shubh)
TTS_SPEAKER=ratan_hi_social      # Billu's voice: casual Delhi-style Hindi persona (Bulbul v4)
REPLY_LANG=hi-IN             # Billu replies in Delhi-style Hinglish
MATCH_USER_LANG=0            # 1 = reply in the language the user spoke
SHELL_CWD=~/Desktop/CatbotDemo   # sandbox cwd for run_command; created at startup
SHADOW=0                     # 1 = run Laya zero-shot alongside the keyword gate, display only
CATBOT_FAKES=0
CATBOT_DB=data/catbot.db
CATBOT_PORT=8765
USE_TF=0
